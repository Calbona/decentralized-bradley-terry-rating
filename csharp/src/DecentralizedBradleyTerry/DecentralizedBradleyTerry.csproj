    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DecentralizedBradleyTerry</RootNamespace>
    <AssemblyName>DecentralizedBradleyTerry</AssemblyName>
    <PackageId>DecentralizedBradleyTerry</PackageId>
